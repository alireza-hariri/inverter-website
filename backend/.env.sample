# Committed defaults for every setting the project reads, and the documentation
# for what each one does. config/env.py loads this file first, then `.env`, then
# the process environment -- so a checkout with no `.env` still starts with a
# coherent set of values, and `.env` only has to carry what differs.
#
# Keep every key the project supports listed here, even the blank ones: an
# undocumented key is one nobody knows they can set.

SECRET_KEY=replace-this-in-development
DEBUG=true
ALLOWED_HOSTS=*
# Extra browser origins allowed to call this API, comma-separated. While
# DEBUG=true every origin is allowed and this can stay blank; production needs
# the frontend's real origin here.
CORS_ALLOWED_ORIGINS=



# Mobile login code delivery: telegram | kavenegar | console.
# `console` logs the code instead of sending it and needs DEBUG=true, which is
# the quickest way to try mobile login with no provider account.
OTP_BACKEND=telegram
# Number of digits in generated mobile login codes (4-10).
OTP_CODE_LENGTH=5

# Telegram relay. Create the bot with @BotFather for the token, add it to the
# staff chat that should receive codes, then read that chat's numeric id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (group ids are negative).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10
# Leave TELEGRAM_PROXY blank when this project is served by the agent: the
# sandbox has its own route out and no `127.0.0.1` in common with the host, so a
# proxy address that works in a host shell resolves to nothing here. A filtered
# network is handled once, on the host, by `egress.upstreamProxy`. Set this only
# for a deployment that reaches Telegram through a proxy of its own.
TELEGRAM_PROXY=
TELEGRAM_BASE_URL=https://api.telegram.org

# Kavenegar SMS. Keep this key on the backend only. Blank sender = shared number.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TIMEOUT=10

# SEO admin. FRONTEND_URL is the public Next.js origin, used for “View on site”
# links and the Google preview in the editor. SEO_INGEST_TOKEN is a shared
# secret the frontend sends when it reports a 404 to the admin's 404 monitor;
# set the same value as SEO_INGEST_TOKEN in the frontend's environment. Blank
# disables 404 reporting unless DEBUG=true.
FRONTEND_URL=http://localhost:3000
SEO_INGEST_TOKEN=

# Seeding. The image-finder service supplies photography; if it is not running,
# `manage.py seed` still seeds, just without images.
IMAGE_FINDER_URL=http://127.0.0.1:3900
IMAGE_FINDER_TIMEOUT=30
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=customer-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-password
